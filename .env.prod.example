# --- Скопируйте в .env на сервере и заполните реальными значениями ---
#
# Один VPS — два стека. Наружу (80/443, TLS) отдаёт ХОСТОВЫЙ nginx, он
# проксирует на localhost-порт стека. На каждом стеке свой .env:
#   production (ветка main):  COMPOSE_PROJECT_NAME=proff58_prod,    WEB_HTTP_PORT=8081
#   staging    (ветка dev):   COMPOSE_PROJECT_NAME=proff58_staging, WEB_HTTP_PORT=8082
# Имя проекта изолирует контейнеры и тома (своя БД/Redis/media у каждого стека).

# Docker-стек
COMPOSE_PROJECT_NAME=proff58_prod
WEB_HTTP_PORT=8081

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=ОБЯЗАТЕЛЬНО-замените-на-длинную-случайную-строку
DJANGO_DEBUG=False
# prod: proff58.ru,www.proff58.ru  |  staging: dev.proff58.ru  (+ IP при отладке)
DJANGO_ALLOWED_HOSTS=proff58.ru,www.proff58.ru,localhost,127.0.0.1
# За фронт-proxy с HTTPS оставляем True (proxy шлёт X-Forwarded-Proto=https).
# Без HTTPS-прокси временно ставьте False, иначе будет редирект-петля.
DJANGO_SECURE_SSL_REDIRECT=True

# База данных (значения должны совпадать с DATABASE_URL ниже)
POSTGRES_DB=proff58
POSTGRES_USER=proff
POSTGRES_PASSWORD=замените-на-надёжный-пароль
DATABASE_URL=postgres://proff:замените-на-надёжный-пароль@db:5432/proff58

# Тюнинг PostgreSQL под RAM сервера. Дефолт PostgreSQL (shared_buffers=128MB) мал:
# большие категории каталога читаются с диска по 20–30 с на первом обращении.
# Значения ниже — под ~8 ГБ RAM (shared_buffers ≈ 25% RAM). На сервере с меньшим
# объёмом памяти уменьши их (напр. для 4 ГБ: SHARED_BUFFERS=1GB, EFFECTIVE_CACHE_SIZE=3GB).
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Кэш Django (отдельная БД Redis 2, не пересекается с Celery 0/1).
REDIS_CACHE_URL=redis://redis:6379/2
# TTL кэша по умолчанию, сек (дерево каталога и т.п.). Инвалидация — по сигналам.
DJANGO_CACHE_TTL=300

# Время жизни соединения с БД между запросами, сек (0 = новое на каждый запрос).
DJANGO_CONN_MAX_AGE=60

# Кол-во воркеров gunicorn (≈ 2 * CPU + 1)
GUNICORN_WORKERS=3

# Sentry (пустой DSN = выключено)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Создание суперпользователя один раз при первом запуске
DJANGO_CREATE_SUPERUSER=false
DJANGO_SUPERUSER_PHONE=+79000000000
DJANGO_SUPERUSER_PASSWORD=замените-на-надёжный-пароль

# MAX Bot (мессенджер) — уведомления и авторизация. Документация: docs/max-bot-setup.md
MAX_BOT_TOKEN=замените-на-токен-бота
MAX_WEBHOOK_SECRET=замените-на-случайный-секрет-32-символа
MAX_BOT_API_URL=https://platform-api.max.ru

# Интеграция с 1С — общий секрет для заголовка X-Api-Key (длинная случайная строка)
ONEC_API_KEY=замените-на-длинный-случайный-ключ
# Максимум строк в одном пакете 1С (items); превышение → 400.
ONEC_MAX_ITEMS=1000
