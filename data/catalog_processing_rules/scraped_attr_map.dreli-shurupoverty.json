{
  "schema_version": 1,
  "category": "dreli-shurupoverty",
  "target_category": {"id": 3, "slug": "elektroinstrument", "name": "Электроинструмент"},
  "created": "2026-08-03",
  "inputs": {
    "prompt": "scratchpad/phase8/prompts/pars-07-dreli-map-validation-prompt.md",
    "report": "scratchpad/parser-mvp/pars-07-dreli-map-report.md",
    "note": "Карта доведена до предсказуемого результата на выборке 60 карточек (ПАРС-07). Можно коммитить как продуктовый артефакт."
  },
  "policy": {
    "ranges": "Диапазоны как значения не сопоставляются, кроме no_load_speed: берётся верхняя граница (range_upper_decimal).",
    "voltage": "Источники дают '220-230В ~50Гц', '220±10% /50', '230/50' и просто '20' (аккумулятор). Для сетевых инструментов — первое число; для аккумуляторных — напряжение батареи. Импортёр сам отбрасывает voltage >=60В для не-аккумуляторных товаров.",
    "motor_type": "ЗУБР отдаёт 'BRUSHLESS, бесщеточный' / 'щеточный'; Вихрь/Ресанта — 'Щеточный'/'Бесщеточный'; Интерскол — 'Бесщеточный (вентильный)'. Нормализовать в brushless/brushed.",
    "chuck": "У дрелей ЗУБР 'ключевой'/'БЗП'; у Вихря 'ключевой'/'быстрозажимной (БЗП)'. В БД у атрибута chuck только SDS-опции, поэтому значения уходят в dropped. Отложено до расширения опций в треке обогащения.",
    "torque": "У Ресанты/Вихря крутящий момент может быть записан как '50/25' (жёсткий/мягкий). Берём первое число — максимальный момент.",
    "weight": "Вес не брать: у разных источников брутто/нетто, атрибута веса нет.",
    "unmapped": "Поля без подходящего Attribute — в unmapped с кандидатом; новые Attribute не создавать.",
    "derived": "Derived-правила power_source в текущей версии парсера работают некорректно (срабатывают безусловно), поэтому удалены из карты. power_source определяется по voltage <60В на этапе планирования."
  },
  "normalizers": {
    "int": "первое целое число строки",
    "decimal": "первое число строки, десятичная запятая -> точка",
    "range_upper_decimal": "'A-B' -> B; если диапазона нет — как decimal",
    "voltage_first": "первое число строки; '220-230В ~50Гц' -> 220, '230/50' -> 230, '220±10% /50' -> 220",
    "option_map": "lower + strip -> словарь values; неизвестное -> drop_to_report"
  },
  "sources": {
    "resanta": {
      "fields": {
        "Частота вращения, об/мин": {
          "action": "map", "attribute": "no_load_speed", "attribute_type": "decimal", "unit": "об/мин",
          "normalize": "range_upper_decimal", "confidence": "medium", "on_ambiguous": "drop_to_report"
        },
        "Тип двигателя": {
          "action": "map", "attribute": "motor_type", "attribute_type": "select",
          "normalize": "option_map",
          "values": {"щеточный": "brushed", "бесщеточный": "brushless"},
          "confidence": "high", "on_unknown_value": "drop_to_report", "on_ambiguous": "drop_to_report"
        },
        "Напряжение аккумулятора, В": {
          "action": "map", "attribute": "voltage", "attribute_type": "decimal", "unit": "В",
          "normalize": "decimal", "confidence": "high", "on_ambiguous": "drop_to_report",
          "comment": "только для аккумуляторных моделей"
        },
        "Напряжение питающей сети, В": {
          "action": "map", "attribute": "voltage", "attribute_type": "decimal", "unit": "В",
          "normalize": "voltage_first", "confidence": "high", "on_ambiguous": "drop_to_report",
          "comment": "сетевые модели: 220-230В -> voltage, но импортёр отбросит как >=60В"
        },
        "Максимальный крутящий момент, Нм": {
          "action": "map", "attribute": "torque", "attribute_type": "decimal", "unit": "Нм",
          "normalize": "decimal", "confidence": "high", "on_ambiguous": "drop_to_report",
          "comment": "'50/25' -> первое число (максимальный момент)"
        },
        "Мощность, Вт": {
          "action": "map", "attribute": "power", "attribute_type": "decimal", "unit": "Вт",
          "normalize": "int", "confidence": "high", "on_ambiguous": "drop_to_report"
        },
        "Диаметр патрона, мм": {
          "action": "unmapped", "candidate_attribute": "chuck_size_mm",
          "reason": "диаметр патрона, не тип; отдельного атрибута нет"
        },
        "Бренд": {"action": "ignore", "reason": "дублирует поле brand карточки"},
        "Гарантия": {"action": "ignore", "reason": "коммерческая информация"},
        "Режим реверса": {"action": "ignore", "reason": "нет атрибута"},
        "Режим удара": {"action": "ignore", "reason": "нет атрибута"},
        "Блокировка шпинделя": {"action": "ignore", "reason": "нет атрибута"},
        "Тип аккумулятора по способу установки": {"action": "ignore", "reason": "нет атрибута"},
        "Максимальный диаметр сверления: дерево/металл, мм": {"action": "ignore", "reason": "нет атрибута"},
        "Максимальный диаметр сверления: сталь/бетон/дерево, мм": {"action": "ignore", "reason": "нет атрибута"},
        "Подсветка рабочей зоны": {"action": "ignore", "reason": "нет атрибута"},
        "Количество аккумуляторов": {"action": "ignore", "reason": "нет атрибута"},
        "Кейс": {"action": "ignore", "reason": "комплектация"},
        "Время заряда аккумулятора, ч": {"action": "ignore", "reason": "нет атрибута"},
        "Корпус редуктора": {"action": "ignore", "reason": "нет атрибута"},
        "Тип патрона": {"action": "ignore", "reason": "опций chuck нет в БД; отложено"},
        "Напряжение сети адаптера питания, В, Гц": {"action": "ignore", "reason": "зарядное устройство, не инструмент"},
        "Вес, кг": {"action": "unmapped", "candidate_attribute": "weight_kg", "reason": "атрибута веса нет"},
        "Габариты упаковки": {"action": "unmapped", "candidate_attribute": "dimensions", "reason": "атрибута нет"}
      },
      "fallbacks": [],
      "derived": []
    },
    "vihr": {
      "fields": {
        "Напряжение аккумулятора, В": {
          "action": "map", "attribute": "voltage", "attribute_type": "decimal", "unit": "В",
