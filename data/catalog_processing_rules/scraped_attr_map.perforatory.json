        }
      ],
      "derived": [
        {
          "attribute": "power_source", "attribute_type": "select", "value": "mains",
          "rule": "mains_if_voltage_field", "confidence": "high",
          "comment": "есть поле «Напряжение питающей сети, В» -> сетевой инструмент"
        }
      ]
    },
