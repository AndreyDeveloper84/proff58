{
  "schema_version": 1,
  "category": "perforatory",
  "target_category": {"id": 3, "slug": "elektroinstrument", "name": "Электроинструмент"},
  "created": "2026-07-28",
  "inputs": {
    "exports": "scratchpad/parser-mvp/output/<source>.products.json (32 карточки Phase 2)",
    "source_structure": "docs/parser-mvp/source-structure.md",
    "roadmap": "docs/plans/2026-07-26-PARSER_ENRICHMENT_MVP_ROADMAP.md Phase 3"
  },
  "policy": {
    "ranges": "Диапазоны как значения не сопоставляются. Исключение — no_load_speed: источники дают «0-N», где N — паспортный максимум оборотов х.х.; берётся верхняя граница (нормализатор range_upper_decimal), решение вынесено владельцу в phase3-report.md.",
    "weight": "Вес не сопоставляется: у resanta/vihr «Вес, кг» — брутто с кейсом, у interskol — нетто, у zubr поля разделены. Атрибут веса к категории «Электроинструмент» не привязан. Все поля веса — в unmapped.",
    "zubr_revers": "Значение «щеточный» в поле «Реверс» у zubr — мусор источника, НЕ тип двигателя. Поле в ignore, с motor_type не сопоставляется.",
    "unmapped": "Поле без подходящего существующего Attribute — в unmapped с кандидатом; новые Attribute/AttributeOption не создаются."
  },
  "normalizers": {
    "int": "первое целое число строки; «800» -> 800",
    "decimal": "первое число строки, десятичная запятая -> точка; «2,8» -> 2.8, «10.0» -> 10.0",
    "range_upper_decimal": "«A-B» -> B (верхняя граница, паспортный максимум); «0-1100» -> 1100, «230-550» -> 550; если диапазона нет — как decimal",
    "voltage_first": "первое число строки (номинал сети); «220-230В, ~50 Гц» -> 220, «230/50» -> 230, «220-240/50» -> 220, «220/50» -> 220",
    "summary_power_w": "regex (\\d+(?:[.,]\\d+)?)\\s*Вт по summary_raw, первое совпадение -> int; «SDS-Plus, 650 Вт, …» -> 650",
    "option_map": "значение -> lower + strip -> словарь values; неизвестное значение -> drop_to_report"
  },
  "sources": {
    "resanta": {
      "fields": {
        "Мощность, Вт": {
          "action": "map", "attribute": "power", "attribute_type": "decimal", "unit": "Вт",
          "normalize": "int", "confidence": "high", "on_ambiguous": "drop_to_report",
          "comment": "в таблице только у 2/8 карточек (75/3/5, 75/3/7); остальные — через fallback из summary_raw"
        },
        "Энергия удара, Дж": {
          "action": "map", "attribute": "energy_impact", "attribute_type": "decimal", "unit": "Дж",
          "normalize": "decimal", "confidence": "high", "on_ambiguous": "drop_to_report"
        },
        "Частота вращения, об/мин": {
          "action": "map", "attribute": "no_load_speed", "attribute_type": "decimal", "unit": "об/мин",
          "normalize": "range_upper_decimal", "confidence": "medium", "on_ambiguous": "drop_to_report",
          "comment": "значения — диапазоны «0-N»; N совпадает со сводкой summary_raw («1100 об/мин»)"
        },
        "Напряжение питающей сети, В": {
          "action": "map", "attribute": "voltage", "attribute_type": "decimal", "unit": "В",
          "normalize": "voltage_first", "confidence": "high", "on_ambiguous": "drop_to_report"
        },
        "Тип хвостовика": {
          "action": "map", "attribute": "chuck", "attribute_type": "select",
          "normalize": "option_map",
          "values": {"sds-plus": "sds-plus", "sds-max": "sds-max"},
          "confidence": "high", "on_unknown_value": "drop_to_report", "on_ambiguous": "drop_to_report"
        },
        "Бренд": {"action": "ignore", "reason": "дублирует поле brand карточки"},
        "Гарантия": {"action": "ignore", "reason": "коммерческая информация, атрибута нет"},
        "Габариты упаковки": {"action": "ignore", "reason": "габариты брутто-упаковки, атрибута нет"},
        "Частота питающей сети, ГЦ": {"action": "ignore", "reason": "частота сети ~50 Гц, атрибута нет и не требуется"},
        "Вес, кг": {
          "action": "unmapped", "candidate_attribute": "weight_kg",
          "reason": "у Ресанты это вес БРУТТО с кейсом (4.926 при нетто 2.7); атрибут веса не привязан к категории «Электроинструмент»"
        },
        "Частота ударов при ударно-вращательном режиме, уд/мин": {
          "action": "unmapped", "candidate_attribute": "impact_rate",
          "reason": "атрибута частоты ударов нет; stroke_rate — другая семантика (ходы пилы, ходов/мин)"
        },
        "Частота ударов, уд/мин": {
          "action": "unmapped", "candidate_attribute": "impact_rate",
          "reason": "вариант подписи у 75/3/13; значение «3750 —» с мусорным хвостом; атрибута нет"
        },
        "Максимальный диаметр сверления: сталь/бетон/дерево, мм": {
          "action": "unmapped", "candidate_attribute": "max_drill_diameter_steel/concrete/wood",
          "reason": "тройное значение «13/24/30» (по материалам, не диапазон); атрибутов диаметров сверления нет; раскладывать не во что"
        },
        "Макс. диаметр сверления (бетон), мм": {
          "action": "unmapped", "candidate_attribute": "max_drill_diameter_concrete",
          "reason": "атрибута нет (вариант подписи у 75/3/13)"
        },
        "Регулировка частоты вращения": {"action": "unmapped", "candidate_attribute": "speed_control", "reason": "атрибута нет"},
        "Режим сверления": {"action": "unmapped", "candidate_attribute": "drill_mode", "reason": "атрибута нет"},
        "Режим сверления с ударом": {"action": "unmapped", "candidate_attribute": "hammer_drill_mode", "reason": "атрибута нет"},
        "Режим удара": {"action": "unmapped", "candidate_attribute": "impact_mode", "reason": "атрибута нет"},
        "Режим реверса": {"action": "unmapped", "candidate_attribute": "reverse", "reason": "атрибута нет"},
        "Реверс": {"action": "unmapped", "candidate_attribute": "reverse", "reason": "атрибута нет (вариант подписи у 75/3/13, значение «Нет»)"},
        "Настройка углового положения инструмента": {"action": "unmapped", "candidate_attribute": "vario_lock", "reason": "атрибута нет"},
        "Антивибрационная система": {"action": "unmapped", "candidate_attribute": "anti_vibration", "reason": "атрибута нет"}
      },
      "fallbacks": [
        {
          "attribute": "power", "attribute_type": "decimal", "unit": "Вт",
