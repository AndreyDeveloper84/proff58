# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных (формат django-environ db URL)
DATABASE_URL=postgres://proff:proff@db:5432/proff58

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Интеграции (заполняются на соответствующих вехах)
# MAX Bot (мессенджер). Документация: docs/max-bot-setup.md
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_BOT_API_URL=https://platform-api.max.ru
# Имя бота для диплинка авторизации: https://max.ru/<username>?start=<token> (#492)
MAX_BOT_USERNAME=
# TTL одноразовой попытки входа через MAX, минут (по умолчанию 5)
MAX_AUTH_ATTEMPT_TTL_MINUTES=5

# --- Вход через VK ID и Яндекс ID (apps.integration_oauth) -------------------
# Провайдер включён, когда заданы его ключи и SITE_URL (https, без пути; от него
# строится адрес возврата {SITE_URL}/api/oauth/<vkid|yandex>/callback/).
# FEATURE_OAUTH_LOGIN=False выключает оба провайдера разом.
FEATURE_OAUTH_LOGIN=True
# VK ID (id.vk.ru → приложение «Web»); сервисный ключ — для конфиденциального приложения.
VKID_CLIENT_ID=
VKID_SERVICE_TOKEN=
# Яндекс ID (oauth.yandex.ru → веб-сервисы, права login:email + login:info).
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
# Сколько живёт незавершённый вход, секунд.
OAUTH_STATE_TTL_SECONDS=600
# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Исходящая почта (DRF-2296) --------------------------------------------
# SMTP любого провайдера. Пустой EMAIL_HOST при заданных получателях в проде =
# отказ старта. DNS отправителя (SPF/DKIM) настраивает владелец домена у провайдера.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
# Ящики сотрудников через запятую — письма о новых заказах и заявках.
# На staging оставить ПУСТЫМ: уведомления лягут в журнал как «пропущено», реальным
# людям ничего не уйдёт. Проверка транспорта: manage.py notifications_email_check --to адрес
STAFF_NOTIFICATION_EMAILS=
# Срок ссылки восстановления пароля покупателя, секунд (DRF-2298).
PASSWORD_RESET_TIMEOUT=3600

# --- Оплата: АТОЛ Pay Ecom -------------------------------------------------
# Публичный https-адрес витрины (returnUrl/notificationUrl для кассы).
SITE_URL=https://dev.proff58.ru
# PF-SH-RELEASE-01 (docs/runbooks/seo-indexing-release.md).
# Секрет SSR витрины: запросы Next→Django с этим значением не попадают под анонимный
# лимит API. Общий для web и frontend. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SSR_INTERNAL_TOKEN=
# Переключатель индексации: только production открывает robots.txt (и только на хосте
# SITE_URL). Пусто/off/любое другое значение → Disallow: /.
SEO_INDEXING=off
PAYMENTS_ENABLED=True
PAYMENT_PROVIDER=atolpay
# Песочница: https://croc-sandbox-api-mobile.atolpay.ru/v1/ecom
ATOLPAY_BASE_URL=https://new-api-mobile.atolpay.ru/v1/ecom
# ЛК АТОЛ Pay → Настройки → API Токены (показывается один раз).
ATOLPAY_TOKEN=
# Свой секрет: уходит в query notificationUrl и проверяется на входе callback.
ATOLPAY_CALLBACK_TOKEN=
# Фискализация: провайдер чеков АТОЛ Онлайн (100), СНО (2 — УСН доход-расход) и
# код ставки НДС (5 — без НДС) — как на вкладке «Чеки» в ЛК АТОЛ Pay.
# Справочник кодов: manage.py atolpay_check --dictionaries
ATOLPAY_RECEIPT_ENABLED=True
ATOLPAY_SNO=2
ATOLPAY_VAT_CODE=5
# SMS
SMS_PROVIDER=
SMS_API_KEY=

# Резерв товара при оформлении B2C-заказа, минут (#568). B2B — всегда 24ч со счётом.
RESERVATION_TTL_B2C_MINUTES=30
# Горизонт показа слотов доставки в checkout, дней (#569).
DELIVERY_SLOT_HORIZON_DAYS=14

# Вежливый темп загрузки изображений: секунд между запросами К ОДНОМУ хосту.
# 0 отключает паузы — только для локалки/тестов.
IMAGE_FETCH_INTERVAL_SECONDS=3.0

# Интеграция с 1С (заголовок X-Api-Key). Пусто = API для 1С закрыт.
ONEC_API_KEY=
# Максимум строк в одном пакете 1С (items); превышение → 400.
ONEC_MAX_ITEMS=1000

# Инфраструктурные feature-флаги (меняют разработчики). Бизнес-флаги
# (отзывы/B2B/акции/...) — в SiteSettings через админку. Проверка — через
# apps.core.features.is_enabled().
FEATURE_CRM=False
FEATURE_AI=False
FEATURE_EVENTBUS=True
FEATURE_EXTERNAL_INTEGRATIONS=True
FEATURE_CATALOG_PROCESSING=False
# Автообработка фото товаров (ADR-0014). Нужен запущенный воркер celery-images.
FEATURE_PRODUCT_IMAGE_AUTOPROCESS=False
