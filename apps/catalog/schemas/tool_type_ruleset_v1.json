{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tool_type ruleset v1 (Phase 6.0 shadow, proposal-only)",
  "type": "object",
  "required": ["version", "ruleset_id", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "ruleset_id": {"type": "string", "pattern": "^tool_type\\.v[0-9]+$"},
    "note": {"type": "string"},
    "rules": {"type": "array", "items": {"$ref": "#/definitions/rule"}},
    "negative_fixtures": {
      "type": "array",
      "items": {"$ref": "#/definitions/negative_fixture"},
      "default": []
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["rule_ref", "option_slug", "match"],
      "additionalProperties": false,
      "properties": {
        "rule_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "option_slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tier": {"type": "string", "enum": ["candidate", "shadow_regression"], "default": "candidate"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brand_any": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
            "name_keywords_any": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
            "source_group_any": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
            "article_prefix_any": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
          }
        },
        "negative_keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "derived_from": {"type": "array", "items": {"type": "integer"}, "default": []},
        "note": {"type": "string"}
      }
    },
    "negative_fixture": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "brand": {"type": "string", "default": ""},
        "source_group": {"type": "string", "default": ""},
        "article": {"type": "string", "default": ""},
        "note": {"type": "string"}
      }
    }
  }
}
