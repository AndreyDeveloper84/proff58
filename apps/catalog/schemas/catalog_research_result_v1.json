{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proff58.ru/schemas/catalog-research-result-v1.json",
  "title": "Catalog Research Result v1",
  "description": "Структурированный результат исследования товаров для catalog processing pipeline.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "taxonomy_hash",
    "export_checksum",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Версия схемы результата."
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID CatalogProcessingRun, для которого создан result."
    },
    "taxonomy_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Taxonomy hash из export-файла."
    },
    "export_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Checksum export-файла, на основе которого выполнено исследование."
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["product_ref", "input_hash", "identity", "status"],
      "additionalProperties": false,
      "properties": {
        "product_ref": {
          "type": "integer",
          "minimum": 1,
          "description": "ID товара, совпадает с CatalogProcessingItem.product_ref."
        },
        "input_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$",
          "description": "SHA-256 хеш входного снапшота."
        },
        "identity": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": ["matched", "partial", "unknown", "mismatch"]
            },
            "brand": { "type": "string", "maxLength": 100 },
            "model": { "type": "string", "maxLength": 100 },
            "article": { "type": "string", "maxLength": 100 },
            "reason": { "type": "string", "maxLength": 255 }
          }
        },
        "status": {
          "type": "string",
          "enum": ["researched", "review", "unknown", "identity_failed"]
        },
        "reason_code": {
          "type": "string",
          "maxLength": 64
        },
        "reason_detail": {
          "type": "string",
          "maxLength": 512
        },
        "changes": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/definitions/change" }
        }
      }
    },
    "change": {
      "type": "object",
      "required": ["target_kind", "proposed_value", "confidence"],
      "additionalProperties": false,
      "properties": {
        "target_kind": {
          "type": "string",
          "enum": ["tool_type"]
        },
        "proposed_value": {
          "type": "object",
          "required": ["option_slug"],
          "additionalProperties": false,
          "properties": {
            "option_slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9-]+$"
            }
          }
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reason_code": {
          "type": "string",
          "maxLength": 64
        },
        "reason_detail": {
          "type": "string",
          "maxLength": 512
        },
        "source": {
          "type": "string",
          "enum": ["web", "llm"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["source_type", "url"],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "manufacturer",
            "manufacturer_pdf",
            "distributor",
            "specialized_store",
            "marketplace"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1024
        },
        "title": {
          "type": "string",
          "maxLength": 255
        },
        "observed_value": {
          "type": "string",
          "maxLength": 255
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
