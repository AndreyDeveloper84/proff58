# --- .env для фронт-proxy (docker-compose.proxy.yml). Положить рядом, назвать .env ---

COMPOSE_PROJECT_NAME=proff58_proxy

# Домены (должны быть направлены A-записью на IP этого сервера)
PROD_DOMAIN=proff58.ru
STAGING_DOMAIN=dev.proff58.ru

# Каталог с сертификатами на хосте (монтируется в /etc/nginx/certs).
CERT_DIR=/home/taximeter/certs

# Имена файлов внутри CERT_DIR.
# SSL_CERT — это fullchain: сертификат домена + промежуточные сертификаты reg.ru
# в одном файле (cat proff58.ru.crt intermediate.crt > fullchain.pem).
# Лучше всего, если сертификат покрывает оба домена (SAN: proff58.ru + dev.proff58.ru).
SSL_CERT=fullchain.pem
SSL_KEY=privkey.pem
