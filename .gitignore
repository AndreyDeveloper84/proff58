# TDD Guard — транзиентное состояние (результаты тестов, журнал правок)
.claude/tdd-guard/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Virtualenv
.venv/
venv/
env/
ENV/

# Django
*.log
logs/*
!logs/.gitkeep
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/
/static_root/

# Environment
.env
.env.*
!.env.example
!.env.prod.example
!.env.proxy.example

# Coverage / tests
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
coverage.xml
*.cover

# Tooling
.ruff_cache/
.mypy_cache/
.pre-commit-cache/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# Node (только для сборки CSS витрины через Tailwind)
node_modules/
npm-debug.log*

# Docker
*.pid
